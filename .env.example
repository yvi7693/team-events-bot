# Токен от @BotFather (обязательно)
BOT_TOKEN=

# Основной часовой пояс команды: в нём показывается время в общем чате
TEAM_TZ=Europe/Moscow

# ID общего чата команды (необязательно — проще написать /bind в группе)
TEAM_CHAT_ID=

# Путь к базе SQLite (в Docker переопределён на /data/bot.sqlite3)
DB_PATH=data/bot.sqlite3

LOG_LEVEL=INFO

# Календарь (Mini App). Публичный HTTPS-адрес, по которому доступен порт WEB_PORT.
# Пусто — календарь выключен, бот работает как раньше.
PUBLIC_URL=
WEB_PORT=8080
